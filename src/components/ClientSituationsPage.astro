---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import { t, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;

const cases = [1,2,3,4,5,6,7].map(i => ({
  n: String(i).padStart(2, '0'),
  title: t(`situations.case${i}.title`, locale),
  situation: t(`situations.case${i}.situation`, locale),
  support: t(`situations.case${i}.support`, locale),
  outcome: t(`situations.case${i}.outcome`, locale),
}));

const situation = t('situations.situation', locale);
const support = t('situations.support', locale);
const outcome = t('situations.outcome', locale);
---

<Layout title={`${t('situations.headline', locale)} | MCSC Group`} description={t('situations.intro', locale).slice(0, 160)} locale={locale}>
  <Navbar locale={locale} />
  <main class="bg-gray-100 min-h-screen">

    <!-- Hero -->
    <section class="pt-32 pb-10 bg-gray-100">
      <div class="mx-auto max-w-7xl px-6">
        <span class="text-brand-gold text-xs font-bold tracking-[0.25em] uppercase block mb-4">{t('situations.label', locale)}</span>
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-brand-navy mb-6">{t('situations.headline', locale)}</h1>
        <p class="text-gray-600 max-w-2xl leading-relaxed text-sm">{t('situations.intro', locale)}</p>
      </div>
    </section>

    <!-- Cards grid -->
    <section class="pb-16 bg-gray-100">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {cases.slice(0, 6).map((c) => (
            <article class="bg-white p-8 flex flex-col gap-5">
              <span class="text-gray-300 text-sm font-mono">{c.n}</span>
              <h2 class="text-lg font-serif font-bold text-brand-navy leading-snug">{c.title}</h2>
              <div class="space-y-4 flex-1">
                <div>
                  <p class="text-[9px] font-bold uppercase tracking-[0.2em] text-brand-gold mb-1">{situation}</p>
                  <p class="text-gray-600 text-sm leading-relaxed">{c.situation}</p>
                </div>
                <div>
                  <p class="text-[9px] font-bold uppercase tracking-[0.2em] text-brand-gold mb-1">{support}</p>
                  <p class="text-gray-600 text-sm leading-relaxed">{c.support}</p>
                </div>
                <div>
                  <p class="text-[9px] font-bold uppercase tracking-[0.2em] text-brand-gold mb-1">{outcome}</p>
                  <p class="text-gray-700 text-sm leading-relaxed font-medium">{c.outcome}</p>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- Last card full-width -->
        <div class="mt-4">
          <article class="bg-white p-8">
            <span class="text-gray-300 text-sm font-mono mb-4 block">{cases[6].n}</span>
            <h2 class="text-lg font-serif font-bold text-brand-navy leading-snug mb-6">{cases[6].title}</h2>
            <div class="grid md:grid-cols-3 gap-8">
              <div>
                <p class="text-[9px] font-bold uppercase tracking-[0.2em] text-brand-gold mb-1">{situation}</p>
                <p class="text-gray-600 text-sm leading-relaxed">{cases[6].situation}</p>
              </div>
              <div>
                <p class="text-[9px] font-bold uppercase tracking-[0.2em] text-brand-gold mb-1">{support}</p>
                <p class="text-gray-600 text-sm leading-relaxed">{cases[6].support}</p>
              </div>
              <div>
                <p class="text-[9px] font-bold uppercase tracking-[0.2em] text-brand-gold mb-1">{outcome}</p>
                <p class="text-gray-700 text-sm leading-relaxed font-medium">{cases[6].outcome}</p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
