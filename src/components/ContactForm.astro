---
import { t, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
---

<section class="py-24 bg-brand-cream" id="contact">
  <div class="mx-auto max-w-7xl px-6">
    <div class="max-w-2xl mx-auto text-center mb-16">
      <span class="text-brand-gold label-upper mb-4 block">{t('nav.contact', locale)}</span>
      <h2 class="text-4xl md:text-5xl mb-4">{t('contact.formTitle', locale)}</h2>
      <p class="text-brand-muted">{t('contact.formIntro', locale)}</p>
    </div>

    <form action="https://formspree.io/f/mqeydjnz" method="POST" class="max-w-3xl mx-auto space-y-8">
      <input type="hidden" name="_language" value={locale} />

      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <label for="firstName" class="label-upper text-[10px] text-brand-muted mb-2 block">{t('contact.firstName', locale)}</label>
          <input type="text" id="firstName" name="firstName" required class="w-full bg-white border border-brand-navy/10 px-4 py-3 text-sm focus:outline-none focus:border-brand-gold transition-colors" />
        </div>
        <div>
          <label for="lastName" class="label-upper text-[10px] text-brand-muted mb-2 block">{t('contact.lastName', locale)}</label>
          <input type="text" id="lastName" name="lastName" required class="w-full bg-white border border-brand-navy/10 px-4 py-3 text-sm focus:outline-none focus:border-brand-gold transition-colors" />
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <label for="email" class="label-upper text-[10px] text-brand-muted mb-2 block">{t('contact.emailLabel', locale)}</label>
          <input type="email" id="email" name="email" required class="w-full bg-white border border-brand-navy/10 px-4 py-3 text-sm focus:outline-none focus:border-brand-gold transition-colors" />
        </div>
        <div>
          <label for="phone" class="label-upper text-[10px] text-brand-muted mb-2 block">{t('contact.phoneLabel', locale)}</label>
          <input type="tel" id="phone" name="phone" class="w-full bg-white border border-brand-navy/10 px-4 py-3 text-sm focus:outline-none focus:border-brand-gold transition-colors" />
        </div>
      </div>

      <div>
        <label for="iAmA" class="label-upper text-[10px] text-brand-muted mb-2 block">{t('contact.iAmA', locale)}</label>
        <select id="iAmA" name="iAmA" required class="w-full bg-white border border-brand-navy/10 px-4 py-3 text-sm focus:outline-none focus:border-brand-gold transition-colors appearance-none" onchange="document.getElementById('sportField').style.display = ['Professional athlete','Emerging athlete','Family member','Athlète professionnel','Athlète émergent','Membre de la famille','Atleta professionista','Atleta emergente','Membro della famiglia'].includes(this.value) ? 'block' : 'none'">
          <option value="" disabled selected>{t('contact.selectOne', locale)}</option>
          <option value={t('contact.proAthlete', locale)}>{t('contact.proAthlete', locale)}</option>
          <option value={t('contact.emergingAthlete', locale)}>{t('contact.emergingAthlete', locale)}</option>
          <option value={t('contact.agentManager', locale)}>{t('contact.agentManager', locale)}</option>
          <option value={t('contact.sportsClub', locale)}>{t('contact.sportsClub', locale)}</option>
          <option value={t('contact.investor', locale)}>{t('contact.investor', locale)}</option>
          <option value={t('contact.familyMember', locale)}>{t('contact.familyMember', locale)}</option>
        </select>
      </div>

      <div id="sportField" style="display:none;">
        <label for="sport" class="label-upper text-[10px] text-brand-muted mb-2 block">{t('contact.sportDiscipline', locale)}</label>
        <input type="text" id="sport" name="sport" placeholder={t('contact.sportPlaceholder', locale)} class="w-full bg-white border border-brand-navy/10 px-4 py-3 text-sm focus:outline-none focus:border-brand-gold transition-colors" />
      </div>

      <div>
        <label for="country" class="label-upper text-[10px] text-brand-muted mb-2 block">{t('contact.country', locale)}</label>
        <select id="country" name="country" required class="w-full bg-white border border-brand-navy/10 px-4 py-3 text-sm focus:outline-none focus:border-brand-gold transition-colors appearance-none">
          <option value="" disabled selected>{t('contact.selectCountry', locale)}</option>
          <option value="Monaco">Monaco</option>
          <option value="Italy">Italy</option>
          <option value="France">France</option>
          <option value="Switzerland">Switzerland</option>
          <option value="Spain">Spain</option>
          <option value="Germany">Germany</option>
          <option value="United Kingdom">United Kingdom</option>
          <option value="United States">United States</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div>
        <p class="label-upper text-[10px] text-brand-muted mb-3">{t('contact.helpWith', locale)}</p>
        <div class="grid sm:grid-cols-2 gap-3">
          {[
            t('contact.helpSportsMgmt', locale),
            t('contact.helpImageRights', locale),
            t('contact.helpTax', locale),
            t('contact.helpRelocation', locale),
            t('contact.helpCorporate', locale),
            t('contact.helpInvestment', locale),
            t('contact.helpCareer', locale),
            t('contact.helpOther', locale),
          ].map((item) => (
            <label class="flex items-center gap-3 cursor-pointer text-sm text-gray-600">
              <input type="checkbox" name="helpWith" value={item} class="accent-brand-gold" />
              {item}
            </label>
          ))}
        </div>
      </div>

      <div>
        <label for="timeline" class="label-upper text-[10px] text-brand-muted mb-2 block">{t('contact.timeline', locale)}</label>
        <select id="timeline" name="timeline" class="w-full bg-white border border-brand-navy/10 px-4 py-3 text-sm focus:outline-none focus:border-brand-gold transition-colors appearance-none">
          <option value="" disabled selected>{t('contact.selectCountry', locale)}</option>
          <option value={t('contact.timelineAsap', locale)}>{t('contact.timelineAsap', locale)}</option>
          <option value={t('contact.timeline1to3', locale)}>{t('contact.timeline1to3', locale)}</option>
          <option value={t('contact.timelineLater', locale)}>{t('contact.timelineLater', locale)}</option>
          <option value={t('contact.timelineExploring', locale)}>{t('contact.timelineExploring', locale)}</option>
        </select>
      </div>

      <div>
        <label for="situation" class="label-upper text-[10px] text-brand-muted mb-2 block">{t('contact.situation', locale)}</label>
        <textarea id="situation" name="situation" rows="5" placeholder={t('contact.situationPlaceholder', locale)} class="w-full bg-white border border-brand-navy/10 px-4 py-3 text-sm focus:outline-none focus:border-brand-gold transition-colors resize-none"></textarea>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <p class="label-upper text-[10px] text-brand-muted mb-3">{t('contact.preferredContact', locale)}</p>
          <div class="space-y-2">
            {[t('contact.contactEmail', locale), t('contact.contactPhone', locale), t('contact.contactVideo', locale)].map((method, i) => (
              <label class="flex items-center gap-3 cursor-pointer text-sm text-gray-600">
                <input type="radio" name="contactMethod" value={method} class="accent-brand-gold" checked={i === 0} />
                {method}
              </label>
            ))}
          </div>
        </div>
        <div>
          <p class="label-upper text-[10px] text-brand-muted mb-3">{t('contact.preferredLang', locale)}</p>
          <div class="space-y-2">
            {['English', 'Français', 'Italiano'].map((lang, i) => (
              <label class="flex items-center gap-3 cursor-pointer text-sm text-gray-600">
                <input type="radio" name="preferredLanguage" value={lang} class="accent-brand-gold" checked={i === 0} />
                {lang}
              </label>
            ))}
          </div>
        </div>
      </div>

      <p class="text-xs text-brand-muted leading-relaxed">
        {t('contact.confidentiality', locale)}
      </p>

      <button type="submit" class="bg-brand-gold text-brand-navy px-10 py-4 label-upper text-xs font-bold hover:bg-brand-navy hover:text-white transition-colors w-full sm:w-auto">
        {t('contact.sendEnquiry', locale)}
      </button>
    </form>
  </div>
</section>
