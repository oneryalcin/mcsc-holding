---
import { t } from '../i18n/utils';

const exploreLinks = [
  { label: t('nav.theGroup'), href: '#the-group' },
  { label: t('nav.expertise'), href: '#expertise' },
  { label: t('nav.keyPeople'), href: '#key-people' },
  { label: t('nav.insights'), href: '#insights' },
];
---

<footer class="bg-brand-navy text-white pt-20 pb-10">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid md:grid-cols-4 gap-12 mb-20">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-2">
        <div class="text-3xl font-serif tracking-widest mb-6">
          MCSC <span class="text-brand-gold">HOLDING</span>
        </div>
        <p class="text-white/40 max-w-sm mb-8 font-light leading-relaxed">
          {t('footer.tagline')}
        </p>
        <div class="flex gap-6">
          <a href="#" class="text-brand-gold hover:text-white transition-colors text-sm">LinkedIn</a>
          <a href="#" class="text-brand-gold hover:text-white transition-colors text-sm">Twitter</a>
          <a href="#" class="text-brand-gold hover:text-white transition-colors text-sm">Instagram</a>
        </div>
      </div>

      <!-- Explore -->
      <div>
        <h4 class="label-upper text-[11px] text-brand-gold mb-6">{t('footer.explore')}</h4>
        <ul class="space-y-4 text-sm font-light text-white/50">
          {exploreLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-brand-gold transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="label-upper text-[11px] text-brand-gold mb-6">{t('footer.contact')}</h4>
        <ul class="space-y-4 text-sm font-light text-white/50">
          <li>info@mcscholding.com</li>
          <li>+377 00 00 00 00</li>
          <li>Monaco &bull; Milan &bull; Geneva</li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-10 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] label-upper text-white/30">
      <p>{t('footer.copyright')}</p>
      <div class="flex gap-8">
        <a href="/privacy" class="hover:text-brand-gold transition-colors">{t('footer.privacy')}</a>
        <a href="/terms" class="hover:text-brand-gold transition-colors">{t('footer.terms')}</a>
        <a href="#" class="hover:text-brand-gold transition-colors">{t('footer.governance')}</a>
      </div>
    </div>
  </div>
</footer>
