---
import { t, getLocalePath, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;

const basePath = locale === 'en' ? '' : `/${locale}`;

const exploreLinks = [
  { label: t('nav.theGroup', locale), href: `${basePath}/#the-group` },
  { label: t('nav.expertise', locale), href: `${basePath}/#expertise` },
  { label: t('nav.keyPeople', locale), href: `${basePath}/#key-people` },
  { label: t('nav.insights', locale), href: `${basePath}/#insights` },
];
---

<footer class="bg-brand-navy text-white pt-20 pb-10">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid md:grid-cols-4 gap-12 mb-20">
      <div class="col-span-1 md:col-span-2">
        <div class="text-3xl font-serif tracking-widest mb-6">
          MCSC <span class="text-brand-gold">MANAGEMENT</span>
        </div>
        <p class="text-white/40 max-w-sm mb-8 font-light leading-relaxed">{t('footer.tagline', locale)}</p>
        <div class="flex gap-6">
          <a href="https://www.linkedin.com/company/montecarlosportconsulting/" target="_blank" rel="noopener noreferrer" class="text-brand-gold hover:text-white transition-colors text-sm">LinkedIn</a>
          <a href="https://www.instagram.com/mcscmanagement" target="_blank" rel="noopener noreferrer" class="text-brand-gold hover:text-white transition-colors text-sm">Instagram</a>
        </div>
      </div>

      <div>
        <h4 class="label-upper text-[11px] text-brand-gold mb-6">{t('footer.explore', locale)}</h4>
        <ul class="space-y-4 text-sm font-light text-white/50">
          {exploreLinks.map((link) => (
            <li><a href={link.href} class="hover:text-brand-gold transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="label-upper text-[11px] text-brand-gold mb-6">{t('footer.contact', locale)}</h4>
        <ul class="space-y-4 text-sm font-light text-white/50">
          <li>info@mcscmanagement.com</li>
          <li>+377 00 00 00 00</li>
          <li>Monaco &bull; Milan &bull; Geneva</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-10 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] label-upper text-white/30">
      <p>{t('footer.copyright', locale)}</p>
      <div class="flex gap-8">
        <a href={getLocalePath('/privacy', locale)} class="hover:text-brand-gold transition-colors">{t('footer.privacy', locale)}</a>
        <a href={getLocalePath('/legal', locale)} class="hover:text-brand-gold transition-colors">{t('footer.terms', locale)}</a>
        <a href="#" class="hover:text-brand-gold transition-colors">{t('footer.governance', locale)}</a>
      </div>
    </div>
  </div>
</footer>
