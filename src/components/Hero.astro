---
import { t, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
---

<section class="relative h-screen flex items-center justify-center overflow-hidden" id="home">
  <img
    src="/images/hero-bg.jpg"
    alt="Modern High-End Corporate Architecture"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
  />
  <div class="absolute inset-0 hero-overlay"></div>

  <div class="relative z-10 text-center px-4 max-w-4xl">
    <h1 class="text-5xl md:text-7xl text-white mb-6 leading-tight">
      {t('hero.headline', locale)}
    </h1>
    <p class="text-brand-sand text-lg md:text-xl font-light mb-10 max-w-2xl mx-auto">
      {t('hero.subtitle', locale)}
    </p>
    <div class="flex flex-col md:flex-row justify-center gap-4">
      <a href="#expertise" class="bg-brand-gold text-brand-navy px-8 py-4 text-xs font-bold uppercase tracking-widest hover:bg-white transition-colors">
        {t('cta.explore', locale)}
      </a>
      <a href="#contact" class="border border-brand-gold text-brand-gold px-8 py-4 text-xs font-bold uppercase tracking-widest hover:bg-brand-gold hover:text-brand-navy transition-all">
        {t('cta.contact', locale)}
      </a>
    </div>
  </div>

  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
