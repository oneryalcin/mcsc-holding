import { t } from '../i18n/utils';

// Phase 1: hardcoded sample articles. Phase 3 will pull from Astro content collections.
const articles = [
  {
    title: 'The Future of NIL Rights in European Football',
    excerpt: 'An in-depth analysis of how Name, Image, and Likeness regulations are evolving across the EU jurisdictions.',
    category: 'News',
    date: 'Oct 2023',
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAV0bVQHmA4iZ3XtK5ZNz_BTPq5RYBZUuq9Alh7O6mR8EIZBzvONJnndAanZ9yRPmF1SWCmRO7YYusVf55XSGjA7-QB2dW_f5j_CtVCy1hjZKIs_8Spi06099ziIwG57aN4Gkp9G5hlplY4cpEnplR2iFw00y2_iEqaLrYd0B_dKqtgLvWH_UYmBwt8HgoZLaNOUMmPkSLHV8E3ShPxDHSsRmoapR-OSVYf61KBSUhxBzIimzWtwRpu2JqhlP9W_xb-PSrfWEEfwYqx',
    slug: 'nil-rights-european-football',
  },
  {
    title: 'Global Sports Summit: Monaco 2023 Recap',
    excerpt: 'MCSC Holding hosts the annual summit on institutional investment in sports infrastructure.',
    category: 'Events',
    date: 'Sept 2023',
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCXqU2JJTasH6ZijhK_-WTuPXEeuhQA6kTltVIr-kwpYtpmkSbFp1BhhgHY1mDMw_EEs4Ok5KNQELCgJJUjHxMycxGO1sfbAqB-3rCiCEWOcCdbjTrCUP1hhO8Sf_FNsPQyo4n_UudlbjrtELW7CmfMZBw0TaeVQQKbQGWe5LvBbx1NFCusCNKDbnkUsk1KXticIFD5Giwr4nNdOsg7-O5zqkwJ4tYTWl5vGOUHRjf5OnjMfgisF-BPCZM7OFFHibNV03PSI-0uSKd1',
    slug: 'monaco-summit-recap',
  },
  {
    title: 'Governance Models for High-Net-Worth Athletes',
    excerpt: 'How integrated holding structures provide long-term wealth stability beyond the pitch.',
    category: 'Insights',
    date: 'Aug 2023',
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAGYAvmkq9OayhZTQVsaSQKnRlIA4IbUgAZ4HbbeV_aV52oyqH99_wK6hHNUyLGhsq2dIT_z6hYBuufPM437Aldeh5zIhdACQRgIUgkOimvxcOqWXQOEBRQCvpitdYv1wNQhOC6J2EmMv7T_XyKZ4SMEd47Amtoj2E2nRuY6A6bXXtZQKid3VtPivVkrOvzPAc6QkOvzVnG_XmXWGh16Y6_0OwvSXgP_j6TDOfPv1hqNtR3GwYShZcLsh2W4n4k5XZsw4lp1OQQpmaZ',
    slug: 'governance-high-net-worth-athletes',
  },
];
---

<section class="py-24 bg-white" id="insights">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex justify-between items-center mb-16">
      <h2 class="text-4xl">{t('insights.headline')}</h2>
      <a
        href="/insights/"
        class="text-xs font-bold label-upper border-b border-brand-gold pb-1 hover:text-brand-gold transition-colors"
      >
        {t('insights.viewAll')}
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {articles.map((article) => (
        <article class="group">
          <a href={`/insights/${article.slug}`} class="block">
            <div class="mb-6 overflow-hidden aspect-video">
              <img
                src={article.image}
                alt={article.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
            </div>
            <span class="text-[10px] label-upper text-brand-gold font-bold">
              {article.category} &bull; {article.date}
            </span>
            <h3 class="text-xl mt-3 mb-4 group-hover:text-brand-gold transition-colors font-serif">
              {article.title}
            </h3>
            <p class="text-sm text-brand-muted line-clamp-3">{article.excerpt}</p>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
