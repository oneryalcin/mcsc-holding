---
import { t, getLocalePath, type Locale } from '../i18n/utils';
import { getLocalizedInsights } from '../i18n/content';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;

const all = await getLocalizedInsights(locale);
const articles = all.slice(0, 3);

const dateLocale = locale === 'fr' ? 'fr-FR' : locale === 'it' ? 'it-IT' : 'en-US';
---

<section class="py-24 bg-white" id="insights">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex justify-between items-center mb-16">
      <h2 class="text-4xl">{t('insights.headline', locale)}</h2>
      <a
        href={getLocalePath('/insights/', locale)}
        class="text-xs font-bold label-upper border-b border-brand-gold pb-1 hover:text-brand-gold transition-colors"
      >
        {t('insights.viewAll', locale)}
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {articles.map(({ entry, slug }) => (
        <article class="group">
          <a href={getLocalePath(`/insights/${slug}`, locale)} class="block">
            <div class="mb-6 overflow-hidden aspect-video">
              <img src={entry.data.coverImage} alt={entry.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
            </div>
            <span class="text-[10px] label-upper text-brand-gold font-bold">
              {entry.data.category} &bull; {new Date(entry.data.publishDate!).toLocaleDateString(dateLocale, { month: 'short', year: 'numeric' })}
            </span>
            <h3 class="text-xl mt-3 mb-4 group-hover:text-brand-gold transition-colors font-serif">{entry.data.title}</h3>
            <p class="text-sm text-brand-muted line-clamp-3">{entry.data.excerpt}</p>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
