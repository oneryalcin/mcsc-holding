---
import { t, type Locale } from '../i18n/utils';
import { getCollection } from 'astro:content';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;

const allTeam = await getCollection('team');
const people = allTeam.sort((a, b) => a.data.order - b.data.order);

const filters = [
  t('people.filters.partners', locale),
  t('people.filters.advisors', locale),
  t('people.filters.providers', locale),
];
---

<section class="py-24 bg-brand-navy text-white" id="key-people">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 gap-6">
      <div class="max-w-2xl">
        <span class="text-brand-gold label-upper mb-4 block">{t('people.label', locale)}</span>
        <h2 class="text-4xl md:text-5xl">{t('people.headline', locale)}</h2>
      </div>
      <div class="flex gap-3">
        {filters.map((f) => (
          <span class="px-4 py-2 border border-brand-gold/30 text-[10px] label-upper cursor-pointer hover:border-brand-gold hover:text-brand-gold transition-colors">
            {f}
          </span>
        ))}
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-12">
      {people.map((person) => (
        <div class="group">
          <div class="aspect-[3/4] overflow-hidden mb-6 relative bg-white/5">
            <img src={person.data.image} alt={person.data.name} class="w-full h-full object-cover img-bw" loading="lazy" />
            <div class="absolute inset-0 bg-brand-gold/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          </div>
          <h3 class="text-2xl font-serif mb-1">{person.data.name}</h3>
          <p class="text-brand-gold text-xs label-upper mb-4">{person.data.role}</p>
          <p class="text-sm text-white/40 font-light italic">"{person.data.quote}"</p>
        </div>
      ))}
    </div>
  </div>
</section>
