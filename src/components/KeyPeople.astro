---
import { t, getLocalePath, type Locale } from '../i18n/utils';
import { getCollection } from 'astro:content';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;

const allTeam = await getCollection('team');
const people = allTeam.sort((a, b) => a.data.order - b.data.order);

---

<section class="py-24 bg-brand-navy text-white" id="key-people">
  <div class="container mx-auto px-6">
    <div class="mb-16">
      <span class="text-brand-gold text-sm font-semibold tracking-widest uppercase mb-4 block">{t('people.label', locale)}</span>
      <h2 class="text-4xl md:text-5xl">{t('people.headline', locale)}</h2>
    </div>

    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-8">
      {people.map((person) => (
        <a href={getLocalePath(`/team/${person.data.slug}`, locale)} class="group flex flex-col">
          <div class="aspect-square overflow-hidden mb-6 relative bg-brand-cream/5">
            <img src={person.data.image} alt={person.data.name} class="w-full h-full object-cover object-top grayscale group-hover:grayscale-0 transition-all duration-500" loading="lazy" />
            <div class="absolute inset-0 bg-brand-gold/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </div>
          <h3 class="text-xl font-serif mb-1 group-hover:text-brand-gold transition-colors">{locale === 'fr' && person.data.honorific ? `Me. ${person.data.name}` : person.data.name}</h3>
          <p class="text-brand-gold text-xs uppercase tracking-widest flex-1">{t(`team.${person.data.slug}.role`, locale)}</p>
          <span class="text-brand-gold text-[10px] uppercase tracking-widest font-bold mt-4 inline-block">{t('ui.learnMore', locale)} &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>
