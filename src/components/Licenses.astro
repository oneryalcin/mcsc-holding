---
import { t, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;

const items = [
  { label: t('licenses.fifa', locale), sublabel: t('licenses.fifaSub', locale), icon: 'sports_soccer' },
  { label: t('licenses.sfaa', locale), sublabel: t('licenses.sfaaSub', locale), icon: 'groups' },
  { label: t('licenses.fa', locale), sublabel: t('licenses.faSub', locale), icon: 'shield' },
  { label: t('licenses.tep', locale), sublabel: t('licenses.tepSub', locale), icon: 'gavel' },
  { label: t('licenses.azek', locale), sublabel: t('licenses.azekSub', locale), icon: 'trending_up' },
];
---

<section class="py-12 border-brand-gold/10 bg-brand-sand" id="licenses">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
      {items.map((item) => (
        <div class="flex items-center gap-4 p-5 rounded-lg border border-brand-gold/10 hover:border-brand-gold/30 transition-all bg-white/50">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-brand-gold/10 text-brand-gold">
            <span class="material-symbols-outlined text-2xl text-brand-gold">{item.icon}</span>
          </div>
          <div class="text-left">
            <p class="text-xs font-bold uppercase tracking-wider text-brand-navy leading-tight">{item.label}</p>
            <p class="text-[10px] mt-1 text-gray-600">{item.sublabel}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
