---
import { t, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;

const offices = [
  { label: t('locations.monaco.label', locale), name: t('locations.monaco.name', locale), address: t('locations.monaco.address', locale) },
  { label: t('locations.milan.label', locale), name: t('locations.milan.name', locale), address: t('locations.milan.address', locale) },
  { label: t('locations.geneva.label', locale), name: t('locations.geneva.name', locale), address: t('locations.geneva.address', locale) },
];
---

<section class="py-24 bg-brand-cream" id="locations">
  <div class="mx-auto max-w-7xl px-6 text-center">
    <div class="bg-white/50 border border-brand-navy/10 p-12 min-h-[480px] flex items-center justify-center relative overflow-hidden">
      <img
        src="https://lh3.googleusercontent.com/aida-public/AB6AXuC7sJiw1vxx5oh9U7nOf1YpP0WF6IhG7SGSF4SnsjQVRoaRuvP9syYw9zWYR5RwIVNAbCuWyqtZ1ZbtpFXAablC650KcAzfYZq83XGS8o6n7D508NpSyTgtbt7WdqnuCVaxs6kZK1LU_thIauH9y7YNx48UviO_zTJ5V2x4oDnkuBv-sQB0GDv1YqDRLm35lgALdDdVua-GLb5NgiT6q6_EVTEAkcroe9IraSx1t2MYcGVPtXu7PvfGbHorRB8E8cLQnFo8A112XEAU"
        alt="" class="opacity-10 absolute inset-0 w-full h-full object-cover" loading="lazy" aria-hidden="true"
      />
      <div class="absolute inset-0 z-0 pointer-events-none hidden md:block">
        <div class="absolute top-[44%] left-[49.5%] flex flex-col items-center">
          <div class="w-3 h-3 bg-brand-gold rounded-full shadow-[0_0_10px_rgba(196,164,74,0.8)]"></div>
          <div class="w-6 h-6 border border-brand-gold rounded-full absolute -top-1.5 pin-glow"></div>
        </div>
        <div class="absolute top-[46%] left-[50.8%] flex flex-col items-center">
          <div class="w-3 h-3 bg-brand-gold rounded-full shadow-[0_0_10px_rgba(196,164,74,0.8)]"></div>
          <div class="w-6 h-6 border border-brand-gold rounded-full absolute -top-1.5 pin-glow" style="animation-delay: 0.5s;"></div>
        </div>
        <div class="absolute top-[43%] left-[49.8%] flex flex-col items-center">
          <div class="w-2.5 h-2.5 bg-brand-gold rounded-full shadow-[0_0_10px_rgba(196,164,74,0.8)]"></div>
        </div>
      </div>
      <div class="z-10 grid grid-cols-1 md:grid-cols-3 gap-12 w-full">
        {offices.map((office) => (
          <div class="group cursor-default">
            <p class="text-brand-gold text-sm font-bold label-upper mb-2 group-hover:text-brand-navy transition-colors">{office.label}</p>
            <p class="text-brand-navy font-semibold text-lg">{office.name}</p>
            <p class="text-xs text-brand-muted mt-2 font-light">{office.address}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
