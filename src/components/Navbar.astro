---
import { t, getLocalePath, locales, type Locale, defaultLocale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;

const basePath = locale === defaultLocale ? '' : `/${locale}`;

const rawPath = Astro.url.pathname;
const pathWithoutLocale = rawPath.replace(/^\/(fr|it)/, '') || '/';
const switchPath = (l: Locale) => l === defaultLocale ? pathWithoutLocale : `/${l}${pathWithoutLocale}`;

type NavItem =
  | { type: 'link'; label: string; href: string }
  | { type: 'dropdown'; label: string; children: { label: string; href: string }[] };

const navItems: NavItem[] = [
  { type: 'link', label: t('nav.home', locale), href: `${basePath}/` },
  {
    type: 'dropdown',
    label: t('nav.theGroup', locale),
    children: [
      { label: t('nav.theGroup', locale), href: `${basePath}/#the-group` },
      { label: t('nav.expertise', locale), href: `${basePath}/#expertise` },
      { label: t('nav.serviceOffers', locale), href: `${basePath}/#service-offers` },
      { label: t('nav.howWeWork', locale), href: getLocalePath('/how-we-work', locale) },
      { label: t('nav.clientSituations', locale), href: getLocalePath('/client-situations', locale) },
      { label: t('nav.locations', locale), href: `${basePath}/#locations` },
    ],
  },
  {
    type: 'dropdown',
    label: t('nav.keyPeople', locale),
    children: [
      { label: t('nav.keyPeople', locale), href: `${basePath}/#key-people` },
      { label: t('nav.partnerships', locale), href: getLocalePath('/partnerships', locale) },
      { label: t('nav.providers', locale), href: getLocalePath('/providers', locale) },
    ],
  },
  { type: 'link', label: t('nav.insights', locale), href: `${basePath}/#insights` },
  { type: 'link', label: t('nav.contact', locale), href: `${basePath}/#contact` },
  { type: 'link', label: t('nav.faq', locale), href: getLocalePath('/faq', locale) },
];
---

<header
  class="fixed w-full z-50 bg-white/95 backdrop-blur-sm text-brand-navy border-b border-brand-gold/20"
  id="site-header"
>
  <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
    <!-- Logo -->
    <a href={`${basePath}/`} class="flex items-center gap-3">
      <img
        src="/images/mcsc-logo.png"
        alt="MCSC Group Logo"
        class="h-10 md:h-12 w-auto object-contain"
      />
      <span class="font-serif text-2xl tracking-tighter hidden md:block text-brand-navy">GROUP</span>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden xl:flex gap-8 text-[10px] uppercase tracking-widest font-bold items-center">
      {navItems.map((item, i) => (
        item.type === 'link' ? (
          <li>
            <a
              href={item.href}
              class:list={[
                'nav-link',
                i === 0 ? 'text-brand-gold' : 'text-brand-navy',
              ]}
            >
              {item.label}
            </a>
          </li>
        ) : (
          <li class="relative group">
            <button
              type="button"
              class="nav-link text-brand-navy flex items-center gap-1 uppercase tracking-widest font-bold text-[10px]"
              aria-haspopup="true"
            >
              {item.label}
              <svg class="w-2.5 h-2.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 top-full pt-3 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-opacity duration-150">
              <ul class="bg-white border border-brand-gold/20 shadow-lg min-w-[260px] py-2">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="block px-5 py-3 text-[10px] uppercase tracking-widest font-bold text-brand-navy hover:bg-brand-cream hover:text-brand-gold transition-colors"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        )
      ))}
    </ul>

    <!-- Language Switcher -->
    <div class="hidden xl:flex items-center gap-2 text-[10px] font-bold opacity-80 bg-brand-cream p-2 rounded-sm">
      {locales.map((l, i) => (
        <>
          {i > 0 && <span>|</span>}
          <a
            href={switchPath(l)}
            class:list={[l === locale ? 'text-brand-gold' : 'text-brand-navy']}
          >
            {l.toUpperCase()}
          </a>
        </>
      ))}
    </div>

    <!-- Mobile Hamburger -->
    <button
      class="xl:hidden flex flex-col gap-1.5 p-2"
      id="mobile-menu-btn"
      aria-label="Open menu"
    >
      <span class="block w-6 h-px bg-brand-navy transition-transform" id="burger-top"></span>
      <span class="block w-6 h-px bg-brand-navy transition-opacity" id="burger-mid"></span>
      <span class="block w-4 h-px bg-brand-navy transition-transform ml-auto" id="burger-bot"></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div class="xl:hidden hidden bg-white/98 border-t border-brand-gold/10" id="mobile-menu">
    <ul class="flex flex-col py-6 px-6 gap-6">
      {navItems.map((item) => (
        item.type === 'link' ? (
          <li>
            <a href={item.href} class="label-upper text-sm text-brand-navy/80 nav-link mobile-nav-link">
              {item.label}
            </a>
          </li>
        ) : (
          <li>
            <button
              type="button"
              class="mobile-dropdown-btn label-upper text-sm text-brand-navy/80 flex items-center gap-2 w-full text-left"
              aria-expanded="false"
            >
              {item.label}
              <svg class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <ul class="mobile-dropdown-panel hidden flex-col gap-3 mt-3 pl-4 border-l border-brand-gold/30">
              {item.children.map((child) => (
                <li>
                  <a href={child.href} class="label-upper text-xs text-brand-navy/70 nav-link mobile-nav-link block">
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        )
      ))}
    </ul>
    <div class="flex gap-4 px-6 pb-6 text-xs label-upper">
      {locales.map((l) => (
        <a
          href={switchPath(l)}
          class:list={[l === locale ? 'text-brand-gold' : 'text-brand-navy/50']}
        >
          {l.toUpperCase()}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const top = document.getElementById('burger-top');
  const mid = document.getElementById('burger-mid');
  const bot = document.getElementById('burger-bot');

  let open = false;

  btn?.addEventListener('click', () => {
    open = !open;
    menu?.classList.toggle('hidden', !open);
    top!.style.transform = open ? 'rotate(45deg) translate(3px, 3px)' : '';
    mid!.style.opacity = open ? '0' : '1';
    bot!.style.transform = open ? 'rotate(-45deg) translate(3px, -3px)' : '';
    bot!.style.width = open ? '1.5rem' : '1rem';
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      open = false;
      menu?.classList.add('hidden');
      top!.style.transform = '';
      mid!.style.opacity = '1';
      bot!.style.transform = '';
      bot!.style.width = '1rem';
    });
  });

  document.querySelectorAll('.mobile-dropdown-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = btn.nextElementSibling as HTMLElement | null;
      const arrow = btn.querySelector('svg');
      if (!panel) return;
      const isOpen = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden', isOpen);
      panel.classList.toggle('flex', !isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
      if (arrow) (arrow as SVGElement).style.transform = isOpen ? '' : 'rotate(180deg)';
    });
  });
</script>
