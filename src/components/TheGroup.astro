---
import { t, type Locale } from '../i18n/utils';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
---

<section class="py-24 bg-white" id="the-group">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
    <div>
      <span class="text-brand-gold text-sm font-semibold tracking-widest uppercase mb-4 block">{t('group.label', locale)}</span>
      <h2 class="text-4xl md:text-5xl mb-8">{t('group.headline', locale)}</h2>
      <div class="space-y-6 text-gray-600 leading-relaxed">
        <p>{t('group.body1', locale)}</p>
        <p>{t('group.body2', locale)}</p>
      </div>
    </div>

    <div class="relative">
      <img
        src="/images/group-photo.jpg"
        alt="High-Performance Sports Facility"
        class="rounded shadow-2xl grayscale hover:grayscale-0 transition-all duration-700"
        loading="lazy"
      />
      <div class="absolute -bottom-6 -left-6 bg-brand-navy p-8 text-white hidden lg:block">
        <p class="text-3xl font-serif">{t('group.legacy', locale)}</p>
        <p class="text-[10px] uppercase tracking-widest text-brand-gold">{t('group.legacyLabel', locale)}</p>
      </div>
    </div>
  </div>
</section>
