---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { t, getLocalePath, type Locale } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  coverImage: string;
  category: string;
  publishDate: Date;
  locale?: Locale;
  canonicalOverride?: string;
}

const { title, description, coverImage, category, publishDate, locale = 'en', canonicalOverride } = Astro.props;

const dateLocale = locale === 'fr' ? 'fr-FR' : locale === 'it' ? 'it-IT' : 'en-US';
const formattedDate = publishDate.toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Article JSON-LD
const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: coverImage.startsWith('http') ? coverImage : `https://mcsc-group.com${coverImage}`,
  datePublished: publishDate.toISOString(),
  publisher: {
    '@type': 'Organization',
    name: 'MCSC Group',
    url: 'https://mcsc-group.com',
  },
  mainEntityOfPage: Astro.url.href,
});
---

<Layout title={`${title} | MCSC Group`} description={description} locale={locale} ogImage={coverImage} canonicalOverride={canonicalOverride}>
  <script type="application/ld+json" set:html={articleJsonLd} />
  <Navbar locale={locale} />
  <main>
    <!-- Hero -->
    <section class="pt-32 pb-16 bg-brand-navy text-white">
      <div class="mx-auto max-w-4xl px-6">
        <div class="mb-6">
          <a href={getLocalePath('/insights/', locale)} class="text-brand-gold text-xs label-upper hover:text-white transition-colors">
            &larr; {t('ui.backToInsights', locale)}
          </a>
        </div>
        <span class="text-brand-gold text-[10px] label-upper font-bold">
          {category} &bull; {formattedDate}
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl mt-4 leading-tight">{title}</h1>
      </div>
    </section>

    <!-- Cover Image -->
    {coverImage && (
      <div class="mx-auto max-w-5xl px-6 -mt-2">
        <img
          src={coverImage}
          alt={title}
          class="w-full aspect-video object-cover shadow-xl"
          loading="eager"
        />
      </div>
    )}

    <!-- Article Body -->
    <article class="mx-auto max-w-3xl px-6 py-16 prose prose-lg">
      <slot />
    </article>
  </main>
  <Footer locale={locale} />
</Layout>

<style is:global>
  .prose {
    color: #1a1a1a;
    line-height: 1.8;
  }
  .prose h2 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-brand-navy);
  }
  .prose h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-brand-navy);
  }
  .prose p {
    margin-bottom: 1.25rem;
  }
  .prose strong {
    color: var(--color-brand-navy);
    font-weight: 600;
  }
  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose ul li {
    list-style-type: disc;
  }
  .prose ol li {
    list-style-type: decimal;
  }
  .prose a {
    color: var(--color-brand-gold);
    text-decoration: underline;
  }
  .prose blockquote {
    border-left: 3px solid var(--color-brand-gold);
    padding: 0.5rem 0 0.5rem 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #555;
  }
  .prose blockquote p {
    margin-bottom: 0.75rem;
  }
  .prose blockquote p:last-child {
    margin-bottom: 0;
  }
</style>
