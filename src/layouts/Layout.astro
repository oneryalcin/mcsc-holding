---
import '../styles/global.css';
import { type Locale, defaultLocale, locales, getLocalePath } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  ogImage?: string;
}

const {
  title = 'MCSC Group',
  description = 'International advisory group at the intersection of sports, entertainment, and private investments. Structured across Luxembourg, Monaco, Switzerland, Italy and UK.',
  locale = defaultLocale,
  ogImage = '/images/mcsc-logo.png',
} = Astro.props;

// Build hreflang URLs from current path
const currentPath = Astro.url.pathname.replace(/^\/(fr|it)/, '') || '/';
const siteUrl = 'https://mcsc-group.com';

// Organization JSON-LD
const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'MCSC Group',
  url: siteUrl,
  logo: `${siteUrl}/images/mcsc-logo.png`,
  description: 'International advisory group at the intersection of sports, entertainment, and private investments.',
  foundingDate: '2024',
  address: [
    {
      '@type': 'PostalAddress',
      streetAddress: '68 Rue de Strasbourg',
      addressLocality: 'Luxembourg',
      addressCountry: 'LU',
    },
    {
      '@type': 'PostalAddress',
      streetAddress: '17 Avenue Albert II',
      addressLocality: 'Monaco',
      addressCountry: 'MC',
    },
    {
      '@type': 'PostalAddress',
      streetAddress: 'Via G.B. Pioda 14',
      addressLocality: 'Lugano',
      addressCountry: 'CH',
    },
    {
      '@type': 'PostalAddress',
      streetAddress: 'Via Rovani 7',
      addressLocality: 'Milan',
      addressCountry: 'IT',
    },
    {
      '@type': 'PostalAddress',
      streetAddress: '38 Craven Street',
      addressLocality: 'London',
      addressCountry: 'GB',
    },
  ],
  sameAs: [
    'https://www.linkedin.com/company/mcscgroup',
    'https://www.instagram.com/mcscgroup',
  ],
});

const websiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'MCSC Group',
  url: siteUrl,
});
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="MCSC Group" />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <!-- hreflang -->
  {locales.map((l) => (
    <link rel="alternate" hreflang={l} href={`${siteUrl}${getLocalePath(currentPath, l)}`} />
  ))}
  <link rel="alternate" hreflang="x-default" href={`${siteUrl}${currentPath}`} />

  <!-- Canonical -->
  <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />

  <!-- Google Fonts: Playfair Display + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;700&display=swap"
    rel="stylesheet"
  />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={orgJsonLd} />
  <script type="application/ld+json" set:html={websiteJsonLd} />

  <!-- Netlify Identity (required for Decap CMS login) -->
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body class="bg-brand-cream text-brand-dark antialiased">
  <slot />

  <!-- Redirect to /admin/ after Netlify Identity login -->
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>

  <!-- GoatCounter Analytics -->
  <script is:inline data-goatcounter="https://mcscgroup.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</body>
</html>
