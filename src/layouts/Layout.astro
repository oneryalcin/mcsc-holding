---
import '../styles/global.css';
import { type Locale, defaultLocale, locales, getLocalePath } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const {
  title = 'MCSC Management | Global Sports Consulting & Management',
  description = 'Providing clear governance and strategic advisory for the next generation of sporting icons and entities.',
  locale = defaultLocale,
} = Astro.props;

// Build hreflang URLs from current path
const currentPath = Astro.url.pathname.replace(/^\/(fr|it)/, '') || '/';

// Organization JSON-LD (spec Section 9.2)
const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'MCSC Management',
  url: 'https://mcsc-management.com',
  logo: 'https://mcsc-management.com/favicon.svg',
  description: 'Global sports advisory and governance firm.',
  foundingDate: '1993',
  address: [
    {
      '@type': 'PostalAddress',
      streetAddress: 'Le Panorama, 57 Rue Grimaldi',
      addressLocality: 'Monaco',
      addressCountry: 'MC',
    },
    {
      '@type': 'PostalAddress',
      streetAddress: 'Via Montenapoleone, 8',
      addressLocality: 'Milan',
      addressCountry: 'IT',
    },
    {
      '@type': 'PostalAddress',
      streetAddress: 'Rue de la Corraterie, 14',
      addressLocality: 'Geneva',
      addressCountry: 'CH',
    },
  ],
  sameAs: [],
});

const websiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'MCSC Management',
  url: 'https://mcsc-management.com',
});
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="MCSC Management" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- hreflang -->
  {locales.map((l) => (
    <link rel="alternate" hreflang={l} href={`https://mcsc-management.com${getLocalePath(currentPath, l)}`} />
  ))}
  <link rel="alternate" hreflang="x-default" href={`https://mcsc-management.com${currentPath}`} />

  <!-- Google Fonts: Playfair Display + DM Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Playfair+Display:wght@400;700&display=swap"
    rel="stylesheet"
  />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={orgJsonLd} />
  <script type="application/ld+json" set:html={websiteJsonLd} />

  <!-- Netlify Identity (required for Decap CMS login) -->
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body class="bg-brand-cream text-brand-dark antialiased">
  <slot />

  <!-- Redirect to /admin/ after Netlify Identity login -->
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
