---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found | MCSC Group" description="The page you are looking for does not exist.">
  <Navbar locale="en" />
  <main class="pt-32 pb-24 min-h-[60vh] flex items-center">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <span class="text-brand-gold text-xs label-upper font-bold">404</span>
      <h1 class="text-4xl sm:text-5xl mt-4 mb-6 text-brand-navy">Page not found</h1>
      <p class="text-brand-dark/70 mb-2">The page you are looking for does not exist or has been moved.</p>
      <p class="text-brand-dark/50 text-sm mb-1">La page que vous recherchez n'existe pas ou a été déplacée.</p>
      <p class="text-brand-dark/50 text-sm mb-10">La pagina che stai cercando non esiste o è stata spostata.</p>
      <div class="flex flex-wrap justify-center gap-6">
        <a href="/" class="label-upper text-sm text-brand-gold hover:text-brand-navy transition-colors">English</a>
        <a href="/fr/" class="label-upper text-sm text-brand-gold hover:text-brand-navy transition-colors">Français</a>
        <a href="/it/" class="label-upper text-sm text-brand-gold hover:text-brand-navy transition-colors">Italiano</a>
      </div>
    </div>
  </main>
  <Footer locale="en" />
</Layout>
