---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Licenses from '../../components/Licenses.astro';
import TheGroup from '../../components/TheGroup.astro';
import StrategicPillars from '../../components/StrategicPillars.astro';
import ServiceOffers from '../../components/ServiceOffers.astro';
import KeyPeople from '../../components/KeyPeople.astro';
import Locations from '../../components/Locations.astro';
import InsightsNews from '../../components/InsightsNews.astro';
import ContactForm from '../../components/ContactForm.astro';
import Footer from '../../components/Footer.astro';

const locale = 'fr' as const;
---

<Layout locale={locale} title="MCSC Management | Conseil & Gestion Sportive Mondiale" description="Gouvernance claire et conseil stratégique pour la prochaine génération d'icônes et d'entités sportives.">
  <Navbar locale={locale} />
  <main>
    <Hero locale={locale} />
    <Licenses locale={locale} />
    <TheGroup locale={locale} />
    <Locations locale={locale} />
    <StrategicPillars locale={locale} />
    <ServiceOffers locale={locale} />
    <KeyPeople locale={locale} />
    <InsightsNews locale={locale} />
    <ContactForm locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
