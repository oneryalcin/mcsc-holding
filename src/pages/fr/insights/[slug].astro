---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getLocalizedInsights } from '../../../i18n/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getLocalizedInsights('fr');
  return articles.map(({ entry, slug, isFallback }) => ({
    params: { slug },
    props: { entry, isFallback },
  }));
}

const { entry, isFallback } = Astro.props;
const { Content } = await render(entry);
const canonicalOverride = isFallback ? `https://mcsc-group.com/insights/${Astro.params.slug}/` : undefined;
---

<ArticleLayout
  title={entry.data.title!}
  description={entry.data.excerpt!}
  coverImage={entry.data.coverImage!}
  category={entry.data.category!}
  publishDate={entry.data.publishDate!}
  canonicalOverride={canonicalOverride}
>
  <Content />
</ArticleLayout>
