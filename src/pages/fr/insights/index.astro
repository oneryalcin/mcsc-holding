---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { t } from '../../../i18n/utils';

const locale = 'fr' as const;
const allInsights = await getCollection('insights');
const sorted = allInsights.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<Layout locale={locale} title="Actualités & Analyses | MCSC Holding" description="Dernières actualités et analyses de MCSC Holding.">
  <Navbar locale={locale} />
  <main>
    <section class="pt-32 pb-16 bg-brand-navy text-white">
      <div class="mx-auto max-w-7xl px-6">
        <span class="text-brand-gold label-upper mb-4 block">{t('insights.headline', locale)}</span>
        <h1 class="text-4xl md:text-5xl">Tous les articles</h1>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid md:grid-cols-3 gap-8">
          {sorted.map((article) => (
            <article class="group">
              <a href={`/fr/insights/${article.id}`} class="block">
                <div class="mb-6 overflow-hidden aspect-video">
                  <img src={article.data.coverImage} alt={article.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                </div>
                <span class="text-[10px] label-upper text-brand-gold font-bold">
                  {article.data.category} &bull; {new Date(article.data.publishDate).toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' })}
                </span>
                <h3 class="text-xl mt-3 mb-4 group-hover:text-brand-gold transition-colors font-serif">{article.data.title}</h3>
                <p class="text-sm text-brand-muted line-clamp-3">{article.data.excerpt}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
