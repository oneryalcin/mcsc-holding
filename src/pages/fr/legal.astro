---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const locale = 'fr' as const;
---

<Layout locale={locale} title="Mentions légales | MCSC Management" description="Mentions légales de MCSC Management.">
  <Navbar locale={locale} />
  <main>
    <section class="pt-32 pb-16 bg-brand-navy text-white">
      <div class="mx-auto max-w-4xl px-6">
        <h1 class="text-4xl md:text-5xl">Mentions légales</h1>
        <p class="text-brand-gold text-xs label-upper mt-4">Informations légales</p>
      </div>
    </section>

    <article class="mx-auto max-w-3xl px-6 py-16 prose-legal">
      <h2>Informations sur la société</h2>
      <p>
        <strong>MCSC Management</strong><br />
        Le Panorama, 57 Rue Grimaldi<br />
        MC-98000 Monaco<br />
        Principauté de Monaco
      </p>
      <p>
        E-mail : info@mcscmanagement.com<br />
        Téléphone : +377 00 00 00 00
      </p>

      <h2>Immatriculation</h2>
      <p>Numéro d'immatriculation : <em>[À fournir par le client]</em></p>
      <p>Personne responsable : <em>[À fournir par le client]</em></p>

      <h2>Bureaux</h2>
      <ul>
        <li><strong>Monaco (siège) :</strong> Le Panorama, 57 Rue Grimaldi</li>
        <li><strong>Milan :</strong> Via Montenapoleone, 8</li>
        <li><strong>Genève :</strong> Rue de la Corraterie, 14</li>
      </ul>

      <h2>Clause de non-responsabilité</h2>
      <p>Le contenu de ce site a été préparé avec le plus grand soin. Cependant, MCSC Management ne peut garantir l'exactitude, l'exhaustivité ou l'actualité des informations fournies.</p>

      <h2>Propriété intellectuelle</h2>
      <p>Tout le contenu de ce site, y compris les textes, images, logos et la conception, est la propriété de MCSC Management et est protégé par les lois applicables en matière de droits d'auteur.</p>
    </article>
  </main>
  <Footer locale={locale} />
</Layout>

<style is:global>
  .prose-legal { color: #1a1a1a; line-height: 1.8; }
  .prose-legal h2 { font-family: var(--font-serif); font-size: 1.5rem; margin-top: 2.5rem; margin-bottom: 0.75rem; color: var(--color-brand-navy); }
  .prose-legal p { margin-bottom: 1.25rem; }
  .prose-legal ul { margin-bottom: 1.25rem; padding-left: 1.5rem; }
  .prose-legal li { margin-bottom: 0.5rem; list-style-type: disc; }
  .prose-legal strong { color: var(--color-brand-navy); font-weight: 600; }
  .prose-legal em { color: var(--color-brand-muted); }
</style>
