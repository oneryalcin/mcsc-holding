---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { t } from '../../../i18n/utils';
import { getLocalizedInsights } from '../../../i18n/content';

const locale = 'it' as const;
const articles = await getLocalizedInsights(locale);
---

<Layout locale={locale} title="Approfondimenti & Notizie | MCSC Management" description="Ultime notizie e approfondimenti da MCSC Management.">
  <Navbar locale={locale} />
  <main>
    <section class="pt-32 pb-16 bg-brand-navy text-white">
      <div class="mx-auto max-w-7xl px-6">
        <span class="text-brand-gold label-upper mb-4 block">{t('insights.headline', locale)}</span>
        <h1 class="text-4xl md:text-5xl">Tutti gli articoli</h1>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid md:grid-cols-3 gap-8">
          {articles.map(({ entry, slug }) => (
            <article class="group">
              <a href={`/it/insights/${slug}`} class="block">
                <div class="mb-6 overflow-hidden aspect-video">
                  <img src={entry.data.coverImage} alt={entry.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                </div>
                <span class="text-[10px] label-upper text-brand-gold font-bold">
                  {entry.data.category} &bull; {new Date(entry.data.publishDate!).toLocaleDateString('it-IT', { month: 'short', year: 'numeric' })}
                </span>
                <h3 class="text-xl mt-3 mb-4 group-hover:text-brand-gold transition-colors font-serif">{entry.data.title}</h3>
                <p class="text-sm text-brand-muted line-clamp-3">{entry.data.excerpt}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
