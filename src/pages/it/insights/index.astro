---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { t } from '../../../i18n/utils';
import { getLocalizedInsights } from '../../../i18n/content';

const locale = 'it' as const;
const articles = await getLocalizedInsights(locale);
---

<Layout locale={locale} title="Insights | MCSC Group" description="Ultimi approfondimenti e notizie da MCSC Group.">
  <Navbar locale={locale} />
  <main>
    <section class="pt-32 pb-16 bg-brand-navy text-white">
      <div class="mx-auto max-w-7xl px-6">
        <h1 class="text-4xl md:text-5xl">{t('insights.headline', locale)}</h1>
        <div class="flex gap-4 mt-6" id="insight-filters">
          {[{ label: t('insights.filterAll', locale), filter: 'all' }, { label: t('insights.filterInsights', locale), filter: 'Insights' }, { label: t('insights.filterNews', locale), filter: 'News' }, { label: t('insights.filterEvents', locale), filter: 'Events' }].map((cat, i) => (
            <button data-filter={cat.filter} class:list={['px-4 py-2 border text-[10px] uppercase tracking-widest transition-colors insight-filter', i === 0 ? 'border-brand-gold text-brand-gold' : 'border-white/30 text-white/60 hover:border-brand-gold hover:text-brand-gold']}>{cat.label}</button>
          ))}
        </div>
      </div>
    </section>
    <section class="py-16 bg-white">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid md:grid-cols-3 gap-8" id="insight-grid">
          {articles.map(({ entry, slug }) => (
            <article class="group insight-card" data-category={entry.data.category}>
              <a href={`/it/insights/${slug}`} class="block">
                <div class="mb-6 overflow-hidden aspect-video">
                  <img src={entry.data.coverImage} alt={entry.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                </div>
                <span class="text-[10px] uppercase text-brand-gold font-bold tracking-widest">{entry.data.category} &bull; {new Date(entry.data.publishDate!).toLocaleDateString('it-IT', { month: 'short', year: 'numeric' })}</span>
                <h3 class="text-xl mt-3 mb-4 group-hover:text-brand-gold transition-colors font-serif">{entry.data.title}</h3>
                <p class="text-sm text-gray-500 line-clamp-3">{entry.data.excerpt}</p>
              </a>
            </article>
          ))}
        </div>
        <p id="no-results" class="hidden text-center text-gray-400 py-16">{t('insights.noResults', locale)}</p>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>

<script>
  const filters = document.querySelectorAll('.insight-filter');
  const cards = document.querySelectorAll('.insight-card');
  const noResults = document.getElementById('no-results');
  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;
      filters.forEach(b => { b.classList.remove('border-brand-gold', 'text-brand-gold'); b.classList.add('border-white/30', 'text-white/60'); });
      btn.classList.add('border-brand-gold', 'text-brand-gold'); btn.classList.remove('border-white/30', 'text-white/60');
      let visible = 0;
      cards.forEach(card => { const cat = (card as HTMLElement).dataset.category; if (filter === 'all' || cat === filter) { (card as HTMLElement).style.display = ''; visible++; } else { (card as HTMLElement).style.display = 'none'; } });
      noResults?.classList.toggle('hidden', visible > 0);
    });
  });
</script>
