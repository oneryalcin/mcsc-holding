---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { t } from '../../../i18n/utils';

const locale = 'it' as const;

const branches = [
  { name: t('locations.london.branch1name', locale), desc: t('locations.london.branch1desc', locale) },
  { name: t('locations.london.branch2name', locale), desc: t('locations.london.branch2desc', locale) },
  { name: t('locations.london.branch3name', locale), desc: t('locations.london.branch3desc', locale) },
  { name: t('locations.london.branch4name', locale), desc: t('locations.london.branch4desc', locale) },
];
---

<Layout
  locale={locale}
  title="Castle Haus Ltd — London | MCSC Group"
  description="Castle Haus Ltd represents a platform where art, fashion and culture converge to create curated encounters that connect artists, audiences and ideas."
>
  <Navbar locale={locale} />
  <main>
    <section class="pt-32 pb-16 bg-brand-navy text-white">
      <div class="container mx-auto max-w-5xl px-6">
        <div class="mb-6">
          <a href="/it/#locations" class="text-brand-gold text-xs uppercase tracking-widest font-bold hover:text-white transition-colors">&larr; Back to Locations</a>
        </div>
        <span class="text-brand-gold text-[10px] uppercase tracking-[0.2em] font-bold">United Kingdom</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl mt-4 leading-tight">Castle Haus Ltd</h1>
        <p class="text-white/60 text-lg mt-4 max-w-2xl font-light">Artistic talent scouting, creative advisory</p>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto max-w-5xl px-6">
        <p class="text-gray-600 text-lg leading-relaxed max-w-3xl">{t('locations.london.desc', locale)}</p>
      </div>
    </section>

    <section class="py-16 bg-brand-cream">
      <div class="container mx-auto max-w-5xl px-6">
        <h3 class="text-sm font-bold uppercase tracking-wider text-brand-navy mb-8">Business Branches</h3>
        <div class="grid md:grid-cols-2 gap-8">
          {branches.map((b) => (
            <div class="bg-white p-8 border-t-4 border-brand-navy">
              <h4 class="font-serif text-xl text-brand-navy mb-3">{b.name}</h4>
              <p class="text-sm text-gray-600 leading-relaxed">{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="container mx-auto max-w-5xl px-6">
        <div class="border-l-2 border-brand-gold pl-6">
          <p class="text-brand-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-2">Office Address</p>
          <p class="text-brand-navy font-serif text-xl">30 St Mary Axe, London EC3A 8BF</p>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
