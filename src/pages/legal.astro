---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const locale = 'en' as const;
---

<Layout locale={locale} title="Legal Notice | MCSC Holding" description="Legal notice and imprint for MCSC Holding.">
  <Navbar locale={locale} />
  <main>
    <section class="pt-32 pb-16 bg-brand-navy text-white">
      <div class="mx-auto max-w-4xl px-6">
        <h1 class="text-4xl md:text-5xl">Legal Notice</h1>
        <p class="text-brand-gold text-xs label-upper mt-4">Imprint</p>
      </div>
    </section>

    <article class="mx-auto max-w-3xl px-6 py-16 prose-legal">
      <h2>Company Information</h2>
      <p>
        <strong>MCSC Holding</strong><br />
        Le Panorama, 57 Rue Grimaldi<br />
        MC-98000 Monaco<br />
        Principality of Monaco
      </p>
      <p>
        Email: info@mcscholding.com<br />
        Phone: +377 00 00 00 00
      </p>

      <h2>Registration</h2>
      <p>Company registration number: <em>[To be provided by client]</em></p>
      <p>Responsible person: <em>[To be provided by client]</em></p>

      <h2>Offices</h2>
      <ul>
        <li><strong>Monaco (HQ):</strong> Le Panorama, 57 Rue Grimaldi</li>
        <li><strong>Milan:</strong> Via Montenapoleone, 8</li>
        <li><strong>Geneva:</strong> Rue de la Corraterie, 14</li>
      </ul>

      <h2>Liability Disclaimer</h2>
      <p>The content of this website has been prepared with the utmost care. However, MCSC Holding cannot guarantee the accuracy, completeness, or timeliness of the information provided. Use of the content is at the user's own risk.</p>

      <h2>Intellectual Property</h2>
      <p>All content on this website, including text, images, logos, and design, is the property of MCSC Holding and is protected by applicable copyright laws. Reproduction or distribution requires prior written consent.</p>

      <h2>External Links</h2>
      <p>This website may contain links to external websites. MCSC Holding has no control over the content of these sites and accepts no responsibility for them.</p>
    </article>
  </main>
  <Footer locale={locale} />
</Layout>

<style is:global>
  .prose-legal { color: #1a1a1a; line-height: 1.8; }
  .prose-legal h2 { font-family: var(--font-serif); font-size: 1.5rem; margin-top: 2.5rem; margin-bottom: 0.75rem; color: var(--color-brand-navy); }
  .prose-legal p { margin-bottom: 1.25rem; }
  .prose-legal ul { margin-bottom: 1.25rem; padding-left: 1.5rem; }
  .prose-legal li { margin-bottom: 0.5rem; list-style-type: disc; }
  .prose-legal strong { color: var(--color-brand-navy); font-weight: 600; }
  .prose-legal em { color: var(--color-brand-muted); }
</style>
