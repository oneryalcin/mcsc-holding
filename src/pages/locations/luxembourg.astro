---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { t } from '../../i18n/utils';

const locale = 'en' as const;

const pillars = [
  {
    title: t('locations.luxembourg.pillar1title', locale),
    items: t('locations.luxembourg.pillar1items', locale).split('|'),
  },
  {
    title: t('locations.luxembourg.pillar2title', locale),
    items: t('locations.luxembourg.pillar2items', locale).split('|'),
  },
  {
    title: t('locations.luxembourg.pillar3title', locale),
    items: t('locations.luxembourg.pillar3items', locale).split('|'),
  },
];
---

<Layout
  locale={locale}
  title="MCSC Holding — Luxembourg | MCSC Group"
  description="MCSC Holding based in Luxembourg is the strategic control tower of the Group, overseeing capital allocation, participations, risk management, and long-term value creation."
>
  <Navbar locale={locale} />
  <main>
    <!-- Hero -->
    <section class="pt-32 pb-16 bg-brand-navy text-white">
      <div class="container mx-auto max-w-5xl px-6">
        <div class="mb-6">
          <a href="/#locations" class="text-brand-gold text-xs uppercase tracking-widest font-bold hover:text-white transition-colors">
            &larr; Back to Locations
          </a>
        </div>
        <span class="text-brand-gold text-[10px] uppercase tracking-[0.2em] font-bold">Luxembourg</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl mt-4 leading-tight">MCSC Holding</h1>
        <p class="text-white/60 text-lg mt-4 max-w-2xl font-light">Strategic control & capital allocation</p>
      </div>
    </section>

    <!-- Description -->
    <section class="py-16 bg-white">
      <div class="container mx-auto max-w-5xl px-6">
        <p class="text-gray-600 text-lg leading-relaxed max-w-3xl">
          {t('locations.luxembourg.desc', locale)}
        </p>
      </div>
    </section>

    <!-- Pillars -->
    <section class="py-16 bg-brand-cream">
      <div class="container mx-auto max-w-5xl px-6">
        <div class="grid md:grid-cols-3 gap-10">
          {pillars.map((pillar) => (
            <div class="bg-white p-8 border-t-4 border-brand-navy">
              <h3 class="text-sm font-bold uppercase tracking-wider text-brand-navy mb-6">{pillar.title}</h3>
              <ul class="space-y-4">
                {pillar.items.map((item) => (
                  <li class="flex items-start gap-3 text-sm text-gray-600 leading-relaxed">
                    <span class="w-1.5 h-1.5 bg-brand-gold rounded-full mt-1.5 shrink-0"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Office info -->
    <section class="py-16 bg-white">
      <div class="container mx-auto max-w-5xl px-6">
        <div class="border-l-2 border-brand-gold pl-6">
          <p class="text-brand-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-2">Office Address</p>
          <p class="text-brand-navy font-serif text-xl">Boulevard Royal, L-2449 Luxembourg</p>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
